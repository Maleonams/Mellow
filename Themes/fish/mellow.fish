# NOTE: put it in ~/.config/fish/conf.d/mellow.fish  pwease :3

# --- Base ---
set -U fish_color_normal '#eaddcf'
set -U fish_color_command '#ffe3a9'
set -U fish_color_param '#c3afff'
set -U fish_color_quote '#a67ee9'
set -U fish_color_redirection '#5f4d8c'
set -U fish_color_operator '#b093ff'
set -U fish_color_end '#b093ff'
set -U fish_color_comment '#8c7acd'
set -U fish_color_autosuggestion '#513a87'
set -U fish_color_valid_path '#c3afff'

# --- Errors / Warnings ---
set -U fish_color_error '#5b31c7'
set -U fish_color_cancel '#39149c'
set -U fish_color_match '#fff2c7'

# --- Prompt & Directory ---
set -U fish_color_cwd '#ffe3a9'
set -U fish_color_cwd_root '#ffb6b6'
set -U fish_color_user '#ffe3a9'
set -U fish_color_host '#a287ff'

# --- Search / Pager / Selection ---
set -U fish_color_search_match '#fff0ca' --background='#5f4d8c'
set -U fish_color_selection '#1a1325' --background='#c3afff'
set -U fish_pager_color_prefix '#ffe3a9'
set -U fish_pager_color_completion '#eaddcf'
set -U fish_pager_color_description '#b093ff'
set -U fish_pager_color_progress '#39149c'

# --- Misc ---
set -U fish_color_history_current '#b093ff'
set -U fish_color_status '#ffb6b6'
set -U fish_color_escape '#ffe3a9'
set -U fish_color_cancel '#5b31c7'
set -U fish_color_operator '#b093ff'
set -U fish_color_option '#c3afff'

# --- Cursor / Background / Foreground (for integration with kitty :3) ---
set -U fish_color_foreground '#eaddcf'
set -U fish_color_background '#1a1325'
set -U fish_color_cursor '#ffe3a9'
