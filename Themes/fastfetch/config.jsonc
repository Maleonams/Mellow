// 888'Y88                 d8    dP,e,           d8            888
// 888 ,'Y  ,"Y88b  dP"Y  d88    8b "   ,e e,   d88    e88'888 888 ee
// 888C8   "8" 888 C88b  d88888 888888 d88 88b d88888 d888  '8 888 88b
// 888 "   ,ee 888  Y88D  888    888   888   ,  888   Y888   , 888 888
// 888     "88 888 d,dP   888    888    "YeeP"  888    "88,e8' 888 888


//     e   e             888 888
//    d8b d8b     ,e e,  888 888  e88 88e  Y8b Y8b Y888P
//   e Y8b Y8b   d88 88b 888 888 d888 888b  Y8b Y8b Y8P
//  d8b Y8b Y8b  888   , 888 888 Y888 888P   Y8b Y8b "
// d888b Y8b Y8b  "YeeP" 888 888  "88 88"     YP  Y8P

{
"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
"logo": {
    "source":"~/.config/fastfetch/blackholeV1.png",
    "type":"kitty-direct",
    "height": 24,
    "width": 96,
    "padding": {
        "top": 1,
        "bottom": 1,
        "right": 2
    }
},
"display": {
    "color": {
        "keys": "blue",    // Key color
        "title": "light_yellow"     // Title color
    },
    "bar": {
        "width": 10,       // Width of percentage bars
        "char": {
            "elapsed": "■", // Character for elapsed portion
            "total": "-"    // Character for total portion
        }
    },
    "percent": {
        "type": 3,         // 1=number, 2=bar, 3=both, 9=colored number
        "color": {
            "green": "green",
            "yellow": "yellow",
            "red": "red"
        }
    }
},
"modules": [
        "break",
        "break",
        {
            "type": "custom",
            "format": "┌─                      Hardware                      ─┐",
            "outputColor": "light_magenta"

        },
        {
            "type": "title",
            "key": "* PC",
            "keyColor": "light_yellow"
        },
        {
            "type": "cpu",
            "key": "┌ ┌ CPU",
            "keyColor": "light_yellow"
        },
        {
            "type": "gpu",
            "key": "│ │ GPU",
            "keyColor": "light_yellow"
        },        
        {
            "type": "memory",
            "key": "│ │ Memory",
            "keyColor": "light_yellow"
        },        
        {
            "type": "swap",
            "key": "└ └ Swap",
            "keyColor": "light_yellow"
        },
        {
            "type": "custom",
            "format": "└─                                                    ─┘",
            "outputColor": "light_magenta"
        },
                
        {
            "type": "custom",
            "format": "┌─                      Software                      ─┐",
            "outputColor": "magenta"        
        },
        {
            "type": "os",
            "key": "* OS",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "┌ ┌ Kernel",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "│ │ Packages",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "│ │ Shell",
            "keyColor": "yellow"
        },
        {
            "type": "command",
            "key": "│ │ OS Age",
            "keyColor": "yellow",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "└ └ Uptime",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "de",
            "key": "* DE",
            "keyColor": "light_blue"
        },
        {
            "type": "lm",
            "key": "┌ ┌ LM",
            "keyColor": "light_blue"
        },
        {
            "type": "wm",
            "key": "│ │ WM",
            "keyColor": "light_blue"
        },
        {
            "type": "wmtheme",
            "key": "│ │ Theme",
            "keyColor": "light_blue"
        },
        {
            "type": "gpu",
            "key": "│ │ GPU Driver",
            "format": "{3}",
            "keyColor": "light_blue"
        },
        {
            "type": "terminal",
            "key": "│ │ Terminal",
            "keyColor": "light_blue"
        },
        {
            "type": "terminalfont",
            "key": "└ └ Terminal Font",
            "keyColor": "light_blue"
        },
        {
            "type": "custom",
            "format": "└─                                                    ─┘",
            "outputColor": "magenta"
        },
        {
            "type": "custom",
            "format": "               \u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m "
        },
        "break"
    ]
}

